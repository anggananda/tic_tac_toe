# =============================================================================
# Environment variables for Tic-Tac-Toe Docker deployment
# Copy this file to .env and adjust values before running docker-compose.
# =============================================================================

# Secret key base for Phoenix (signs cookies, etc.)
# Generate one with: mix phx.gen.secret
SECRET_KEY_BASE=change-this-to-a-long-random-secret-key

# Erlang distribution cookie — MUST be identical on ALL nodes
# so they are allowed to join the same cluster.
TIC_TAC_TOE_COOKIE=tic_tac_toe_cookie

# Example node names (set these per machine / per container):
#   TIC_TAC_TOE_NODE_NAME=tic@node-a
#   TIC_TAC_TOE_CLUSTER_NODES=tic@node-b
#
# For two laptops, use IP addresses or hostnames that each laptop
# can resolve:
#   Laptop A: TIC_TAC_TOE_NODE_NAME=tic@192.168.1.10
#             TIC_TAC_TOE_CLUSTER_NODES=tic@192.168.1.11
#   Laptop B: TIC_TAC_TOE_NODE_NAME=tic@192.168.1.11
#             TIC_TAC_TOE_CLUSTER_NODES=tic@192.168.1.10
