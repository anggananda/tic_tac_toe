<Layouts.flash_group flash={@flash} />

<div class="min-h-screen flex flex-col bg-base-100 text-base-content overflow-hidden">
  <header class="shrink-0 flex items-center justify-between px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-2">
      <img src={~p"/images/logo.svg"} width="30" height="30" />
      <span class="text-sm font-semibold tracking-tight">Tic Tac Toe</span>
    </div>
    <div class="flex items-center gap-2">
      <a href="/game" class="btn btn-primary btn-sm px-4 py-2 text-sm">Mulai Bermain</a>
      <Layouts.theme_toggle />
    </div>
  </header>

  <main class="flex-1 flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 text-center">
    <div class="relative z-10 inline-block">
      <div class="absolute -inset-1 bg-primary/20 rounded-full blur-[64px] pointer-events-none">
      </div>
      <div class="absolute -inset-1 bg-secondary/20 rounded-full blur-[48px] -translate-y-1/3 pointer-events-none">
      </div>

      <h1 class="relative z-20 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter mb-4">
        Tic<span class="text-primary">TacToe</span>
      </h1>
      <p class="relative z-20 text-lg sm:text-xl text-base-content/60 max-w-xl leading-relaxed mb-10">
        Mainkan strategis dengan lawan secara real-time.<br />
        Antarmuka minimalis, responsif, dan tanpa kebingungan.
      </p>

      <div class="relative z-20 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/game" class="btn btn-primary btn-lg px-8 py-3 text-base font-medium">
          Mulai Bermain
        </a>
        <a href="/game" class="btn btn-ghost btn-lg px-8 py-3 text-base font-medium">
          Langsung Main
        </a>
      </div>
    </div>

    <div class="mt-12 flex items-center justify-center opacity-80">
      <div class="grid grid-cols-3 gap-2 p-4 bg-base-200/60 rounded-2xl shadow-xl border border-base-300/50">
        <%= for cell <- 0..8 do %>
          <div class="aspect-square w-10 sm:w-12 bg-base-300 rounded-xl"></div>
        <% end %>
      </div>
    </div>
  </main>
</div>
